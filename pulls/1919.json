    "title": "ecdh/ellswift/schnorrsig: return early for invalid inputs (consistent handling w.r.t. constant-time)",
    "user": {
      "login": "theStack",
      "id": 91535,
      "node_id": "MDQ6VXNlcjkxNTM1",
